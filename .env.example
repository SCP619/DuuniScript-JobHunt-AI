# Copy to .env and adjust. Never commit .env.
# All values are optional; the defaults are shown.

# Private data directory. Default: %LOCALAPPDATA%\DuuniScript
# APP_DATA_DIR=C:\Users\<WindowsUser>\AppData\Local\DuuniScript

# API binding. Keep loopback unless authentication and firewall rules exist.
# API_HOST=127.0.0.1
# API_PORT=8000

# Comma-separated list of allowed frontend origins (local dev servers only).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Maximum accepted request body size in bytes for JSON endpoints.
# MAX_REQUEST_BYTES=1048576

# Maximum document upload size in bytes (default 20 MB).
# MAX_UPLOAD_BYTES=20971520

# Job URL import: a single fetch you trigger yourself. Set to false to disable all fetching.
# URL_IMPORT_ENABLED=true
# URL_IMPORT_TIMEOUT_SECONDS=15

# Job alert emails: read-only IMAP access to ONE mailbox label (docs/BACKEND_SETUP.md, section 10).
# The password is never put here: save it with  .venv\Scripts\python.exe scripts\set_mail_password.py
# MAIL_IMAP_USER=you@gmail.com
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_IMAP_PORT=993
# MAIL_FOLDER=DuuniScript
# Minutes between automatic checks while the API runs; 0 turns them off.
# MAIL_SYNC_INTERVAL_MINUTES=60
# How far back the first check looks.
# MAIL_BACKFILL_DAYS=30

# Official job feeds and public job APIs (docs/BACKEND_SETUP.md, section 11).
# Minutes between looks for feeds that are due (each site has its own minimum interval); 0 = off.
# FEED_SYNC_INTERVAL_MINUTES=60
# FEED_TIMEOUT_SECONDS=30
# Remote jobs limited to other countries (e.g. "USA only") are not added.
# FEED_SKIP_UNAVAILABLE=true
# Optional: only add feed jobs whose title or description contains one of these words.
# FEED_KEYWORDS=python, data, analyst

# Backups: a zip of the database and documents in APP_DATA_DIR\backups every N hours while the
# API runs (0 = off), keeping the newest BACKUP_KEEP. Restore: scripts\restore_backup.py
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=10

# Sign-in sessions last this many days (a passphrase is created in the app).
# AUTH_SESSION_DAYS=30

# Connected accounts (docs/BACKEND_SETUP.md section 15). Keep the client file outside the repo.
# GOOGLE_OAUTH_CLIENT_FILE=C:\Users\<you>\AppData\Local\DuuniScript\google-client.json
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_TENANT=organizations

# Optional local AI wording (Ollama on this computer only).
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://127.0.0.1:11434
